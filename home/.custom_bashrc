# Find files
_ff_core() {
    local pattern="$1"
    local dir="${2:-.}"

    if [ -z "$pattern" ]; then
        echo "Usage: ${FUNCNAME[1]} <pattern> [directory]" >&2
        return 1
    fi

    dir="$(cd "$dir" 2>/dev/null && pwd)" || {
        echo "Directory not found: ${2:-.}" >&2
        return 1
    }

    find "$dir" -iname "*${pattern}*"
}

ff() {
    _ff_core "$@"
}

ffv() {
    local results
    results="$(_ff_core "$@")" || return 1

    if [ -z "$results" ]; then
        echo "No matches found." >&2
        return 1
    fi

    vim - <<< "$results"
}


[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
[user]
	# NOTE FOR NEW SETUP: Remember to copy .gitconfig.local.template
	# to .gitconfig.local and fill in your real email!
	# Fallback values in case .gitconfig.local hasn't been created yet:
	name = Your Name
	email = placeholder@users.noreply.github.com
[include]
	path = ~/.gitconfig-home
	path = ~/.gitconfig.local
[safe]
	directory = /mnt/windows/Data/git/*
[core]
	autocrlf = input
